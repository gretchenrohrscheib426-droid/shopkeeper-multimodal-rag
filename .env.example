# Copy to .env.local; never commit real secrets. Explicit SHOPKEEPER_ENV_FILE is recommended.
# Copy the exact workspace endpoint from the Model Studio console.
# Set MODEL_CONFIG_SOURCE=file in the private file to reject stale OS model overrides.
MODEL_CONFIG_SOURCE=environment
OPENAI_API_BASE=https://YOUR-WORKSPACE-ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=qwen-plus
VL_MODEL=qwen3-vl-plus
ITEM_MODEL=qwen-plus
APP_API_TOKEN=
APP_ALLOWED_HOSTS=127.0.0.1,localhost
APP_USERS_JSON={}
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=shopkeeper_chunks_v2
ITEM_NAME_COLLECTION=shopkeeper_entities_v2
ENTITY_NAME_COLLECTION=shopkeeper_entities_v2
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=shopkeeper_reproduction_v2
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=shopkeeper-reproduction-v2
MINIO_SECURE=false
BGE_M3_PATH=
BGE_RERANKER_LARGE=
BGE_DEVICE=cuda:0
BGE_FP16=true
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL_REVISION=55611d7bca2a7133960a6d3b71e083071bbfc312
MINERU_EXECUTABLE=
MINERU_BACKEND=vlm-auto-engine
MINERU_TIMEOUT_SECONDS=900
MODEL_TIMEOUT_SECONDS=60
STORAGE_TIMEOUT_SECONDS=5
MAX_UPLOAD_MB=40
WEB_SEARCH_ENABLED=false
MCP_API_URL=
MCP_API_KEY=
MCP_ALLOWED_HOSTS=
MCP_SEARCH_TOOL=
